{
	"name": "@layermix/cli",
	"version": "1.0.0",
	"description": "DAG-based task runner CLI with Ink TUI",
	"type": "module",
	"bin": {
		"layermix": "dist/cli/index.js"
	},
	"files": [
		"dist",
		"schema.json",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"license": "MIT",
	"author": "Layermix",
	"homepage": "https://github.com/layermix-labs/cli#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/layermix-labs/cli.git"
	},
	"bugs": {
		"url": "https://github.com/layermix-labs/cli/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"task-runner",
		"dag",
		"cli",
		"tui",
		"ink",
		"monorepo",
		"build",
		"ci"
	],
	"scripts": {
		"start": "vite-node src/cli/index.tsx",
		"test": "vitest run",
		"generate-schema": "vite-node scripts/generate-schema.ts",
		"build": "rm -rf dist && tsc --noCheck && chmod +x dist/cli/index.js",
		"prepublishOnly": "npm run generate-schema && npm run build",
		"lint": "biome lint src scripts test",
		"lint:fix": "biome lint --write src scripts test",
		"format": "biome format --write src scripts test",
		"format:check": "biome format src scripts test",
		"check": "biome check src scripts test",
		"check:fix": "biome check --write src scripts test",
		"ci": "biome ci src scripts test",
		"typecheck": "tsgo --noEmit -p tsconfig.check.json",
		"typecheck:src": "tsgo --noEmit -p tsconfig.json",
		"typecheck:watch": "tsgo --noEmit -p tsconfig.check.json --watch",
		"fallow": "fallow",
		"fallow:dead": "fallow dead-code",
		"fallow:dupes": "fallow dupes",
		"fallow:health": "fallow health",
		"audit": "fallow audit",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset publish"
	},
	"packageManager": "pnpm@10.5.2",
	"dependencies": {
		"ansi-regex": "^6.2.2",
		"chalk": "4",
		"clipboardy": "^5.0.2",
		"commander": "^14.0.2",
		"cosmiconfig": "^9.0.0",
		"execa": "^9.6.1",
		"graph-data-structure": "^4.5.0",
		"ink": "^6.6.0",
		"ink-spinner": "^5.0.0",
		"is-ci": "^4.1.0",
		"react": "^19.2.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@changesets/cli": "^2.27.10",
		"@types/clipboardy": "^2.0.4",
		"@types/cosmiconfig": "^6.0.3",
		"@types/node": "^25.0.8",
		"@types/react": "^19.2.8",
		"@typescript/native-preview": "7.0.0-dev.20260416.2",
		"fallow": "^2.38.0",
		"tsx": "^4.21.0",
		"vite-node": "^5.2.0",
		"vitest": "^4.0.17"
	},
	"optionalDependencies": {
		"@fallow-cli/darwin-arm64": "^2.38.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"fallow"
		]
	}
}
