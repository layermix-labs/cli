<% if (formName) { %>
import <%= formName %>Form from "~/<%= domain %>/components/<%= formName %>Form/<%= formName %>Form";
<% } %>

export default function <%= pageName %>() {
  return (
    <div>
      <h1><%= pageName %></h1>
      <% if (formName) { %>
        <<%= formName %>Form />
      <% } %>
    </div>
  );
}
