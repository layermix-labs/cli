{
  "tasks": [
    {
      "id": "clean",
      "cmd": "rm -rf dist",
      "tags": ["build"],
      "dependsOn": []
    },
    {
      "id": "compile",
      "cmd": "tsc",
      "dependsOn": ["clean"],
      "tags": ["build"]
    },
    {
      "id": "lint",
      "cmd": "eslint .",
      "tags": ["test"],
      "dependsOn": []
    },
    {
      "id": "test",
      "cmd": "vitest run",
      "dependsOn": ["compile", "lint"],
      "tags": ["test"]
    },
    {
      "id": "bundle",
      "cmd": "esbuild src/index.ts --bundle --outfile=dist/bundle.js",
      "dependsOn": ["compile"],
      "tags": ["build"]
    }
  ],
  "env": {
    "NODE_ENV": "development"
  }
}